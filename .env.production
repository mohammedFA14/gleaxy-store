# ============================================
#  إعدادات متجر Galaxy Store
#  Galaxy Store Configuration
# ============================================

# ---- إعدادات الأدمن (Admin) ----
# إيميل الأدمن وكلمة المرور
# Admin email and password
VITE_ADMIN_EMAIL=admin@galaxystore.com
VITE_ADMIN_PASSWORD=galaxy123

# ---- إعدادات Firebase (اختياري) ----
# إذا أردت ربط الموقع بفايربيس، أضف هذه الإعدادات
# If you want to connect the site to Firebase, add these settings
# VITE_FIREBASE_API_KEY=your_api_key_here
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIRELAB_APP_ID=your_app_id

# ---- إعدادات المتجر ----
# اسم المتجر
VITE_STORE_NAME=Galaxy Store
VITE_STORE_DESCRIPTION=متجر إلكتروني متكامل للخدمات الرقمية
VITE_STORE_URL=https://galaxy-store.netlify.app

# ---- إعدادات الدفع ----
# معلومات الدفع (اختياري)
VITE_PAYMENT_ENABLED=true
VITE_PAYMENT_METHODS=بايناس,تك ماستر كارد,زين كاش,اسيا سيل

# ---- إعدوات التواصل ----
# معلومات التواصل
VITE_WHATSAPP_NUMBER=07701234567
VITE_TELEGRAM_USERNAME=@galaxy_store
VITE_DISCORD_SERVER=https://discord.gg/galaxy-store